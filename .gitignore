# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Environment and secrets (API keys, credentials, service accounts)
.env
.env.local
.env.*.local
.env.*
!.env.example

# Sensitive & unnecessary JSON files (e.g., GCP service account keys, credentials, data dumps)
*.json
# Whitelist essential Node.js configuration files
!package.json
!package-lock.json
!tsconfig*.json

# Logs and runtime data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build and output directories
dist/
build/
out/

# Cache and temporary files
.cache/
.temp/
tmp/
*.db*
*.sqlite*
uploads/*
!uploads/.gitkeep

# Operating system files
.DS_Store
Thumbs.db

# IDE and editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
